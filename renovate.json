{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>NethServer/.github:ns8-automerge"
    ],
    "packageRules": [
        {
            "matchDatasources": ["github-release"],
            "matchPackageNames": ["immich-app/immich"],
            "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
        }
    ]
}
